CONFIG_IDF_TARGET="esp32s3"

# ESP32-S3-WROOM-1-N16R8: 16 MB Quad-Flash, 8 MB Octal-PSRAM
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# Two OTA slots for later OTA updates
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000

# Console on the native USB (USB-Serial-JTAG, IO19/IO20)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# WLAN and lwIP stay on core 0, IR runs on core 1
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_0=y
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE=n

# RMT callbacks stay usable while flash cache is off
CONFIG_RMT_ISR_IRAM_SAFE=y
