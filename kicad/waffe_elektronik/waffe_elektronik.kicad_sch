  (text "STROMVERSORGUNG" (at 20.32 30.48 0)
    (effects (font (size 2.5 2.5)))
  )
  (text "5V_PERIPH speist WS2812 + MAX98357A + 74AHCT125." (at 20.32 154.94 0)
    (effects (font (size 1.3 1.3)))
  )
  (text "3V3_MCU speist NUR das MCU-3V3-Pin (DevKitC-eigene"
    (at 20.32 157.48 0)
    (effects (font (size 1.3 1.3)))
  )
  (text "5V->3V3-LDO wird dadurch bewusst nicht genutzt)." (at 20.32 161.29 0)
    (effects (font (size 1.3 1.3)))
  )
  (text "VBUS_NATIVE = eigener USB-C-Port der Waffe (Flash-Port),"
    (at 20.32 163.83 0)
    (effects (font (size 1.3 1.3)))
  )
  (text "nur fuer den Lader - keine Rueckspeisung aus Boost/Akku."
    (at 20.32 166.37 0)
    (effects (font (size 1.3 1.3)))
  )
  (text "WAFFE - ESP32-S3-DevKitC-1 (Hauptplatine)" (at 100.33 30.48 0)
    (effects (font (size 2.5 2.5)))
  )
  (text "IR-SENDER" (at 170.18 30.48 0)
    (effects (font (size 2.5 2.5)))
  )
  (text "2x TSAL6100 parallel, je eigener Vorwiderstand (readme.md Abschnitt 4)."
    (at 170.18 80.01 0)
    (effects (font (size 1.3 1.3)))
  )
  (text "ABZUG / NACHLADEN" (at 170.18 100.33 0)
    (effects (font (size 2.5 2.5)))
  )
  (text "RUECKSTOSS- / TREFFER-VIBRATION" (at 170.18 160.02 0)
    (effects (font (size 2.5 2.5)))
  )
  (text "WS2812 (5V) UEBER PEGELWANDLER" (at 229.87 30.48 0)
    (effects (font (size 2.5 2.5)))
  )
  (text "Munitionsanzeige haengt als weitere WS2812-Pixel am physischen"
    (at 229.87 90.17 0)
    (effects (font (size 1.3 1.3)))
  )
  (text "DOUT-Pin des HP-Streifens (Daisy-Chain, hier nicht separat"
    (at 229.87 92.71 0)
    (effects (font (size 1.3 1.3)))
  )
  (text "dargestellt) - GPIO1/GPIO2 bleiben dadurch frei." (at 229.87 96.52 0)
    (effects (font (size 1.3 1.3)))
  )
  (text "Falls OLED statt LED-Zeile gewuenscht: GPIO1/2 als I2C nutzen."
    (at 229.87 99.06 0)
    (effects (font (size 1.3 1.3)))
  )
  (text "SOUND" (at 229.87 115.57 0)
    (effects (font (size 2.5 2.5)))
  )
  (text "SD_MODE fest auf 5V_PERIPH (immer aktiv), GAIN_SLOT auf GND"
    (at 229.87 165.1 0)
    (effects (font (size 1.3 1.3)))
  )
  (text "(Standard-Gain) - siehe pinbelegung.md offene Fragen."
    (at 229.87 167.64 0)
    (effects (font (size 1.3 1.3)))
  )
  (text "SENSORKABEL ZUR WESTE (GX12/GX16, 7-polig)" (at 20.32 229.87 0)
    (effects (font (size 2.5 2.5)))
  )
  (text "WESTE (jenseits des Steckers, nur Sensoren, kein Chip)"
